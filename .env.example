# Copy to .env. `langgraph deploy` uploads every variable here as a deployment secret,
# except reserved names such as LANGSMITH_API_KEY (used locally and by the CLI only).
#
# NEVER add LANGSMITH_AGENT_ID, LANGSMITH_AGENT_ENVIRONMENT or LANGSMITH_PROJECT here.
# A deployment bound to an agent environment sets its own LANGSMITH_PROJECT, and the
# agent variables next to it switch tracing off. The Makefile sets them for local runs.

# A workspace-scoped key (lsv2_sk_...) for the agent-based workspace. Needs the
# gateway:invoke and workspaces:read permissions (Workspace Admin has both).
LANGSMITH_API_KEY=lsv2_sk_...
LANGSMITH_TRACING=true

# Key for the LangSmith LLM Gateway. Models are `langsmith:custom/<org model config>`
# (see src/chat_langchain/settings.py), so no provider key exists anywhere in this app.
LANGSMITH_GATEWAY_API_KEY=lsv2_sk_...

# Key the deep agent uses to create thread sandboxes. Can be the same key as above.
LANGSMITH_SANDBOX_API_KEY=lsv2_sk_...

# Optional: bring your own online judge (any OpenAI-compatible endpoint at a public URL).
# Put these lines in a file named .env.judge, NOT in this file: .env is uploaded to every
# deployment, and they don't need this key. `make provision` / `make online-evals` then store
# the key as a workspace secret and create the model configuration chat-langchain-judge.
#   CHATLC_ONLINE_JUDGE_API_KEY=sk-...
#   CHATLC_ONLINE_JUDGE_BASE_URL=https://api.openai.com/v1
#   CHATLC_ONLINE_JUDGE_MODEL=gpt-5.5
